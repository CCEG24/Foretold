+    /// Configures the canvas context, rethrowing a rejection from the browser.
+    ///
+    /// `configure(_:)` calls through JavaScriptKit's non-throwing path, so the
+    /// `TypeError` an implementation raises for a configuration it doesn't
+    /// support — an `rgba16float` canvas is still unimplemented in Firefox
+    /// (bugzilla 1834395) — unwinds the WebAssembly instance instead of
+    /// returning. A caller that can fall back to a narrower configuration has
+    /// to be able to catch that.
+    public func configureThrowing(_ configuration: GPUCanvasConfiguration) throws {
+        _ = try jsObject.throwing.configure!(configuration.toJSObject())
+    }
